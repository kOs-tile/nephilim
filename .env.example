# ─── Ethereum / Arbitrum Node ──────────────────────────────────────────────────
# Alchemy WebSocket endpoint (get one at https://alchemy.com)
ALCHEMY_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Optional: Arbitrum via QuickNode
QUICKNODE_ARB_WS_URL=wss://distinguished-example.arbitrum-mainnet.quiknode.pro/YOUR_KEY/

# ─── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nephilim_secret

# ─── TimescaleDB / PostgreSQL ──────────────────────────────────────────────────
TIMESCALE_DSN=postgresql://nephilim:nephilim_secret@localhost:5432/nephilim
TIMESCALE_USER=nephilim
TIMESCALE_PASSWORD=nephilim_secret
TIMESCALE_DB=nephilim

# ─── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_RAW_BLOCKS=raw_blocks
KAFKA_TOPIC_DECODED_TXS=decoded_txs
KAFKA_TOPIC_MEV_EVENTS=mev_events

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Token price cache TTL in seconds
TOKEN_PRICE_CACHE_TTL=30

# ─── Telegram Alerts ───────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFghijklmnopqrstuvwxyz
TELEGRAM_CHAT_ID=-1001234567890
# Minimum MEV value in ETH to trigger an alert
ALERT_MIN_MEV_ETH=1.0

# ─── Model Paths ───────────────────────────────────────────────────────────────
MEV_CLASSIFIER_MODEL_PATH=models/mev_classifier.pkl
MEV_CLASSIFIER_LABEL_ENCODER_PATH=models/label_encoder.pkl

# ─── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Ethereum mainnet=1, Arbitrum One=42161
CHAIN_ID=1
# How many blocks back to backfill on startup (0 = live only)
BACKFILL_BLOCKS=0
# GraphQL / FastAPI server
API_HOST=0.0.0.0
API_PORT=8000
